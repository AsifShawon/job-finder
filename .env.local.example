# Local development only. These defaults are intentionally simple and unsafe for production.
COMPOSE_PROJECT_NAME=ooi_local

APP_NAME=Overseas Opportunity Intelligence Platform for Bangladeshis
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=local-dev-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_DB=ooi
POSTGRES_USER=ooi
POSTGRES_PASSWORD=ooi
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://ooi:ooi@postgres:5432/ooi

REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-docs
MINIO_SECURE=false
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

WEB_HOST_PORT=3000
API_HOST_PORT=8000
FLOWER_HOST_PORT=5555
SEARXNG_HOST_PORT=8080
SERVER_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

AI_PROVIDER=groq
AI_MODEL=
AI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CRAWLER_USER_AGENT=OOI-Platform/1.0 (+https://localhost)
ENABLE_SCHEDULED_CRAWLS=false
CRAWLER_SMOKE_MODE=false
RELIEFWEB_APPNAME=ooi-bd-opportunities-dev
SEARCH_PROVIDER=searxng
SEARCH_PROVIDER_BASE_URL=http://searxng:8080
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_TIMEOUT_SECONDS=15
RATE_LIMIT_COPILOT=20/minute

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sudokkho.xyz
SMTP_TLS=true

USAJOBS_API_KEY=
USAJOBS_USER_AGENT=bd-opportunity-platform
