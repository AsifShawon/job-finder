# Production template for the Ubuntu VPS.
# Copy this file to .env.prod and replace every placeholder before starting.
COMPOSE_PROJECT_NAME=ooi_prod

APP_NAME=Overseas Opportunity Intelligence Platform for Bangladeshis
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# REQUIRED: replace with a long random secret.
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_DB=ooi
POSTGRES_USER=ooi
# REQUIRED: replace. Do not use the local default password in production.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://ooi:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/ooi

REDIS_URL=redis://redis:6379/0

# REQUIRED: replace MinIO root credentials. Do not use minioadmin/minioadmin.
MINIO_ROOT_USER=REPLACE_WITH_STRONG_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_USER
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET=raw-docs
MINIO_SECURE=false

# FASTPANEL reverse proxy should point to these localhost ports.
WEB_HOST_PORT=3001
API_HOST_PORT=8001
FLOWER_HOST_PORT=5555
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Server-side web requests stay inside Docker. Browser/client requests must use the public API domain.
SERVER_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
WEB_BASE_URL=https://app.example.com

AI_PROVIDER=groq
AI_MODEL=
AI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CRAWLER_USER_AGENT=OOI-Platform/1.0 (+https://app.example.com)
ENABLE_SCHEDULED_CRAWLS=false
CRAWLER_SMOKE_MODE=false
RELIEFWEB_APPNAME=ooi-bd-opportunities-prod
SEARCH_PROVIDER=searxng
SEARCH_PROVIDER_BASE_URL=http://searxng:8080
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_TIMEOUT_SECONDS=15
RATE_LIMIT_COPILOT=20/minute

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

USAJOBS_API_KEY=
USAJOBS_USER_AGENT=bd-opportunity-platform
