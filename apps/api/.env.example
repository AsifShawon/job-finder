APP_NAME=Overseas Opportunity Intelligence Platform for Bangladeshis
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-super-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://ooi:ooi@postgres:5432/ooi
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=groq
AI_MODEL=
AI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-docs
MINIO_SECURE=false
CRAWLER_USER_AGENT=OOI-Platform/1.0 (+https://localhost)
RATE_LIMIT_COPILOT=20/minute
WEB_BASE_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@sudokkho.xyz
SMTP_TLS=true


SEARCH_PROVIDER=searxng
SEARCH_PROVIDER_BASE_URL=http://searxng:8080
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_TIMEOUT_SECONDS=15
